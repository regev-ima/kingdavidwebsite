# Copy this file to `.env.local` and fill in the values from your kcrm
# Supabase project (Settings -> API).
#
# IMPORTANT: only the anon (public) key belongs here. NEVER commit the
# service_role key to the repository or expose it in client code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps JavaScript API key (Places Autocomplete for the checkout
# address field). Restrict this key in the Google Cloud Console to:
#   - HTTP referrers: your website domain(s)
#   - APIs: only "Maps JavaScript API" and "Places API"
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Hyp / Yaad hosted-page integration for credit-card checkout.
#
# `VITE_HYP_MODE`:
#   - "test"  → clicking "כרטיס אשראי" opens the bundled mock iframe
#               (/checkout/hyp-mock) so the flow can be exercised
#               without a live account.
#   - "live"  → loads the real Hyp hosted page. Requires a configured
#               `VITE_HYP_TERMINAL` and a server-side notify verifier.
#
# Until the Hyp account is provisioned, leave MODE=test and TERMINAL
# empty; once you have credentials, flip MODE to "live" and fill in
# the terminal.
VITE_HYP_MODE=test
VITE_HYP_TERMINAL=
VITE_HYP_BASE_URL=https://icom.yaad.net/p/

# Meta (Facebook) Pixel + Conversions API.
#
# `VITE_FB_PIXEL_ID` is the public Pixel ID, baked into the bundle so
# the browser-side fbq snippet can fire. Leave empty to skip the
# Pixel entirely (the server-side CAPI still works on its own).
#
# The Conversions API access token + test event code live as
# Supabase Function secrets — never in this file:
#   supabase secrets set META_PIXEL_ID=...
#   supabase secrets set META_CAPI_ACCESS_TOKEN=...
#   supabase secrets set META_CAPI_TEST_EVENT_CODE=TESTxxxxx   # optional
VITE_FB_PIXEL_ID=
